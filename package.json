{
  "name": "ttz-server",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26.13.1 <27"
  },
  "scripts": {
    "build": "turbo run build",
    "check": "turbo run check",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --env-file=.env --filter @ttz/database generate",
    "db:validate": "pnpm --filter @ttz/database check",
    "db:migrate": "pnpm --env-file=.env --filter @ttz/database migrate:dev",
    "db:migrate:status": "pnpm --env-file=.env --filter @ttz/database migrate:status",
    "db:migrate:baseline": "pnpm --env-file=.env --filter @ttz/database migrate:baseline",
    "wcl:sync-reference-data": "pnpm --filter @ttz/api sync:wcl-reference-data",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "turbo": "^2.5.6"
  },
  "lint-staged": {
    "**/*.{js,mjs,ts}": "./node_modules/.bin/biome check --write --no-errors-on-unmatched"
  }
}
