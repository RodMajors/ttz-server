{
  "name": "@ttz/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/bundle.mjs",
    "dev": "tsx watch --env-file=../../.env src/main.ts",
    "start": "node --env-file=../../.env dist/server.cjs",
    "lint": "tsc --noEmit",
    "check": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "seed:local-admin": "tsx --env-file=../../.env scripts/seed-local-admin.ts",
    "sync:wcl-reference-data": "tsx --env-file=../../.env scripts/sync-wcl-reference-data.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/swagger": "^11.2.0",
    "@prisma/client": "^6.16.2",
    "@ttz/config": "workspace:*",
    "@ttz/contracts": "workspace:*",
    "@ttz/database": "workspace:*",
    "@ttz/warcraft-logs": "workspace:*",
    "bullmq": "^5.58.5",
    "ioredis": "^5.6.1",
    "nest-winston": "^1.10.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "winston": "^3.18.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "tsx": "^4.20.6",
    "typescript": "^6.0.3",
    "vitest": "^4.0.18"
  }
}
