generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                                                                      BigInt                    @id @default(autoincrement()) @db.UnsignedBigInt
  name                                                                    String?                   @db.VarChar(255)
  wxNickname                                                              String?                   @map("wx_nickname") @db.VarChar(255)
  guildNickname                                                           String?                   @map("guild_nickname") @db.VarChar(255)
  openid                                                                  String                    @unique(map: "uk_openid") @db.VarChar(128)
  unionid                                                                 String?                   @db.VarChar(128)
  avatar                                                                  String?                   @db.VarChar(255)
  privilege                                                               Int                       @default(0) @db.TinyInt
  isApproved                                                              Int                       @default(0) @map("is_approved") @db.TinyInt
  reviewedBy                                                              BigInt?                   @map("reviewed_by") @db.UnsignedBigInt
  reviewedAt                                                              DateTime?                 @map("reviewed_at") @db.DateTime(0)
  rejectReason                                                            String?                   @map("reject_reason") @db.VarChar(255)
  remark                                                                  String?                   @db.VarChar(255)
  status                                                                  Int                       @default(1) @db.TinyInt
  last_login_at                                                           DateTime?                 @db.DateTime(0)
  createdAt                                                               DateTime                  @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt                                                               DateTime                  @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)
  activities                                                              Activity[]
  activity_signups_activity_signups_handled_byTousers                     ActivitySignup[]          @relation("activity_signups_handled_byTousers")
  signups                                                                 ActivitySignup[]
  announcementsCreated                                                    Announcement[]            @relation("AnnouncementCreatedBy")
  announcementsUpdated                                                    Announcement[]            @relation("AnnouncementUpdatedBy")
  attendance_records_attendance_records_recorded_byTousers                AttendanceRecord[]        @relation("attendance_records_recorded_byTousers")
  attendanceRecords                                                       AttendanceRecord[]
  authSessions                                                            AuthSession[]
  characters                                                              Character[]
  guild_group_members_guild_group_members_added_byTousers                 GuildGroupMember[]        @relation("guild_group_members_added_byTousers")
  groupMemberships                                                        GuildGroupMember[]
  guild_groups                                                            GuildGroup[]
  loginSessions                                                           LoginSession[]
  notification_deliveries                                                 notification_deliveries[]
  notificationPreference                                                  NotificationPreference?
  site_settings                                                           SiteSetting[]
  users                                                                   User?                     @relation("usersTousers", fields: [reviewedBy], references: [id], onUpdate: Restrict, map: "fk_users_reviewed_by")
  other_users                                                             User[]                    @relation("usersTousers")
  wcl_attendance_suggestions_wcl_attendance_suggestions_applied_byTousers WclAttendanceSuggestion[] @relation("wcl_attendance_suggestions_applied_byTousers")
  wclAttendanceSuggestions                                                WclAttendanceSuggestion[]
  wcl_report_actors                                                       WclReportActor[]
  wcl_reports                                                             WclReport[]
  wclUserLink                                                             WclUserLink?
  wclOAuthSessions                                                        WclOAuthSession[]
  verifiedCharacters                                                      Character[]                @relation("CharacterVerifiedBy")

  @@index([isApproved, status], map: "idx_users_approval")
  @@index([reviewedBy], map: "idx_users_reviewed_by")
  @@map("users")
}

model AuthSession {
  id               BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  userId           BigInt    @map("user_id") @db.UnsignedBigInt
  accessTokenHash  String    @unique(map: "uk_auth_session_access") @map("access_token_hash") @db.Char(64)
  refreshTokenHash String?   @unique(map: "uk_auth_session_refresh") @map("refresh_token_hash") @db.Char(64)
  kind             Int       @default(0) @db.TinyInt
  accessExpiresAt  DateTime  @map("access_expires_at") @db.DateTime(0)
  refreshExpiresAt DateTime? @map("refresh_expires_at") @db.DateTime(0)
  revokedAt        DateTime? @map("revoked_at") @db.DateTime(0)
  createdAt        DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_auth_session_user")

  @@index([userId, revokedAt], map: "idx_auth_session_user")
  @@index([refreshExpiresAt], map: "idx_auth_session_refresh_expiry")
  @@map("auth_sessions")
}

model LoginSession {
  id                BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  loginNo           String    @unique(map: "uk_login_no") @map("login_no") @db.VarChar(64)
  nonceHash         String?   @map("nonce_hash") @db.Char(64)
  browserSecretHash String?   @map("browser_secret_hash") @db.Char(64)
  openid            String?   @db.VarChar(128)
  userId            BigInt?   @map("user_id") @db.UnsignedBigInt
  status            Int       @default(0) @db.TinyInt
  ip                String?   @db.VarChar(64)
  expireAt          DateTime  @map("expire_at") @db.DateTime(0)
  scannedAt         DateTime? @map("scanned_at") @db.DateTime(0)
  confirmedAt       DateTime? @map("confirmed_at") @db.DateTime(0)
  consumedAt        DateTime? @map("consumed_at") @db.DateTime(0)
  cancelledAt       DateTime? @map("cancelled_at") @db.DateTime(0)
  createdAt         DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)
  user              User?     @relation(fields: [userId], references: [id], onUpdate: Restrict, map: "fk_login_session_user")

  @@index([userId], map: "idx_login_session_user")
  @@index([expireAt], map: "idx_expire")
  @@map("login_session")
}

model Character {
  id                       BigInt                    @id @default(autoincrement()) @db.UnsignedBigInt
  userId                   BigInt                    @map("user_id") @db.UnsignedBigInt
  name                     String                    @db.VarChar(64)
  serverName               String                    @map("server_name") @db.VarChar(64)
  serverSlug               String                    @map("server_slug") @db.VarChar(64)
  serverRegion             String                    @default("cn") @map("server_region") @db.VarChar(16)
  classId                  Int                       @map("class_id")
  raceId                   Int?                      @map("race_id")
  faction                  Int?                      @db.TinyInt
  raceName                 String?                   @map("race_name") @db.VarChar(64)
  gender                   String?                   @db.VarChar(16)
  guildName                String?                   @map("guild_name") @db.VarChar(128)
  guildServerName          String?                   @map("guild_server_name") @db.VarChar(64)
  guildServerSlug          String?                   @map("guild_server_slug") @db.VarChar(64)
  activeSpecName           String?                   @map("active_spec_name") @db.VarChar(64)
  level                    Int?
  activeTitle              String?                   @map("active_title") @db.VarChar(128)
  serverTypeName           String?                   @map("server_type_name") @db.VarChar(64)
  averageItemLevel         Int?                      @map("average_item_level")
  lastLoginAt              DateTime?                 @map("last_login_at") @db.DateTime(0)
  achievementPoints        Int?                      @map("achievement_points")
  gameData                 Json?                     @map("game_data")
  isMain                   Int                       @default(0) @map("is_main") @db.TinyInt
  isRetired                Int                       @default(0) @map("is_retired") @db.TinyInt
  remark                   String?                   @db.VarChar(255)
  wclId                    BigInt                    @map("wcl_id") @db.UnsignedBigInt
  wclCanonicalId           BigInt                    @map("wcl_canonical_id") @db.UnsignedBigInt
  wclVerificationStatus    Int                       @default(0) @map("wcl_verification_status") @db.TinyInt
  wclVerifiedAt             DateTime?                 @map("wcl_verified_at") @db.DateTime(0)
  wclEvidence               String?                   @map("wcl_evidence") @db.VarChar(16)
  wclVerifiedBy             BigInt?                   @map("wcl_verified_by") @db.UnsignedBigInt
  wclVerificationNote      String?                   @map("wcl_verification_note") @db.VarChar(255)
  itemLevel                Int?                      @map("item_level")
  itemLevelUpdatedAt       DateTime?                 @map("item_level_updated_at") @db.DateTime(0)
  created_at               DateTime                  @default(now()) @db.DateTime(0)
  updated_at               DateTime                  @default(now()) @db.DateTime(0)
  activities               Activity[]
  signupChoices            ActivitySignupChoice[]
  signups                  ActivitySignup[]
  attendanceRecords        AttendanceRecord[]
  user                     User                      @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "characters_users_id_fk")
  characterClass           classes                   @relation(fields: [classId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_character_class")
  race                     Race?                     @relation(fields: [raceId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_character_race")
  verifiedByUser           User?                     @relation("CharacterVerifiedBy", fields: [wclVerifiedBy], references: [id], onDelete: SetNull, onUpdate: Restrict, map: "fk_character_verified_by")
  wclAttendanceSuggestions WclAttendanceSuggestion[]
  wclReportActors          WclReportActor[]

  @@unique([serverRegion, serverSlug, name], map: "uk_character_identity")
  @@unique([serverRegion, wclCanonicalId], map: "uk_character_wcl_canonical")
  @@unique([serverRegion, wclId], map: "uk_character_wcl_id")
  @@index([userId], map: "idx_user_id")
  @@index([classId], map: "idx_character_class")
  @@index([raceId], map: "idx_character_race")
  @@index([wclVerifiedBy], map: "idx_character_verified_by")
  @@map("characters")
}

model WclUserLink {
  id             BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  userId         BigInt   @unique(map: "uk_wcl_user_link_user") @map("user_id") @db.UnsignedBigInt
  wclUserId      Int      @map("wcl_user_id")
  wclUsername    String   @map("wcl_username") @db.VarChar(64)
  wclRegion      String   @default("cn") @map("wcl_region") @db.VarChar(16)
  linkedAt       DateTime @map("linked_at") @db.DateTime(0)
  lastVerifiedAt DateTime? @map("last_verified_at") @db.DateTime(0)
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_wcl_user_link_user")

  @@unique([wclRegion, wclUserId], map: "uk_wcl_user_link_region_user")
  @@map("wcl_user_links")
}

model WclOAuthSession {
  id           BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  userId       BigInt    @map("user_id") @db.UnsignedBigInt
  stateHash    String    @unique(map: "uk_wcl_oauth_state") @map("state_hash") @db.Char(64)
  codeVerifier String    @map("code_verifier") @db.VarChar(255)
  redirectUri  String    @map("redirect_uri") @db.VarChar(255)
  expiresAt    DateTime  @map("expires_at") @db.DateTime(0)
  consumedAt   DateTime? @map("consumed_at") @db.DateTime(0)
  createdAt    DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_wcl_oauth_session_user")

  @@index([userId, expiresAt], map: "idx_wcl_oauth_session_user")
  @@index([expiresAt, consumedAt], map: "idx_wcl_oauth_session_expiry")
  @@map("wcl_oauth_sessions")
}

model Race {
  id         Int         @id
  name       String      @db.VarChar(32)
  enName     String?     @map("en_name") @db.VarChar(32)
  faction    Int?        @db.TinyInt
  icon       String?     @db.VarChar(255)
  characters Character[]

  @@map("races")
}

model WclServer {
  id               Int      @id
  name             String   @db.VarChar(64)
  slug             String   @db.VarChar(64)
  region           String   @default("cn") @db.VarChar(16)
  blizzardId       Int?     @map("blizzard_id")
  connectedRealmId Int?     @map("connected_realm_id")
  createdAt        DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)

  @@unique([region, slug], map: "uk_wcl_server_region_slug")
  @@index([name], map: "idx_wcl_server_name")
  @@map("wcl_servers")
}

model ActivityType {
  id          BigInt     @id @default(autoincrement()) @db.UnsignedBigInt
  name        String     @db.VarChar(32)
  code        String     @unique(map: "uk_activity_type_code") @db.VarChar(32)
  category    String     @db.VarChar(32)
  description String?    @db.VarChar(255)
  sort        Int?       @default(0)
  is_active   Int?       @default(1)
  created_at  DateTime?  @default(now()) @db.DateTime(0)
  activities  Activity[]

  @@map("activity_types")
}

model Activity {
  id                       BigInt                    @id @default(autoincrement()) @db.UnsignedBigInt
  name                     String                    @db.VarChar(64)
  type                     BigInt                    @db.UnsignedBigInt
  status                   Int                       @default(0) @db.SmallInt
  creator                  BigInt                    @db.UnsignedBigInt
  template                 BigInt?                   @default(0) @db.UnsignedBigInt
  description              String?                   @db.LongText
  inviter                  BigInt?                   @db.UnsignedBigInt
  passphrase               String?                   @db.VarChar(255)
  signupDeadline           DateTime?                 @map("signup_deadline") @db.DateTime(0)
  maxPlayers               Int                       @default(20) @map("max_players") @db.UnsignedSmallInt
  tankSlots                Int?                      @map("tank_slots") @db.UnsignedSmallInt
  healerSlots              Int?                      @map("healer_slots") @db.UnsignedSmallInt
  meleeSlots               Int?                      @map("melee_slots") @db.UnsignedSmallInt
  rangedSlots              Int?                      @map("ranged_slots") @db.UnsignedSmallInt
  teamUpAt                 DateTime?                 @map("team_up_at") @db.DateTime(0)
  beginAt                  DateTime                  @map("begin_at") @db.DateTime(0)
  endAt                    DateTime                  @map("end_at") @db.DateTime(0)
  durationMinutes          Int                       @default(120) @map("duration_minutes") @db.UnsignedSmallInt
  attendanceEnabled        Int                       @default(0) @map("attendance_enabled") @db.TinyInt
  publishedAt              DateTime?                 @map("published_at") @db.DateTime(0)
  rosterLockedAt           DateTime?                 @map("roster_locked_at") @db.DateTime(0)
  finishedAt               DateTime?                 @map("finished_at") @db.DateTime(0)
  cancelledAt              DateTime?                 @map("cancelled_at") @db.DateTime(0)
  version                  Int                       @default(1) @db.UnsignedInt
  createdAt                DateTime                  @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt                DateTime                  @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)
  isDeleted                Int                       @default(0) @map("is_deleted") @db.TinyInt
  characters               Character?                @relation(fields: [inviter], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "activities_characters_id_fk")
  typeDefinition           ActivityType              @relation(fields: [type], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "activities_types_id_fk")
  creatorUser              User                      @relation(fields: [creator], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "activities_users_id_fk")
  activity_casual_ext      activity_casual_ext?
  activity_mythic_plus_ext activity_mythic_plus_ext?
  activity_raid_ext        activity_raid_ext?
  signups                  ActivitySignup[]
  attendanceRecords        AttendanceRecord[]
  wclReports               WclReport[]

  @@index([isDeleted, status, beginAt], map: "idx_activities_list")
  @@index([creator, beginAt], map: "idx_activities_creator_time")
  @@index([inviter], map: "activities_characters_id_fk")
  @@index([type], map: "activities_types_id_fk")
  @@map("activities")
}

model ActivitySignup {
  id                                       BigInt                 @id @default(autoincrement()) @db.UnsignedBigInt
  activityId                               BigInt                 @map("activity_id") @db.UnsignedBigInt
  userId                                   BigInt                 @map("user_id") @db.UnsignedBigInt
  characterId                              BigInt                 @map("character_id") @db.UnsignedBigInt
  preferredRole                            Int?                   @map("preferred_role") @db.TinyInt
  preferredSpecId                          Int?                   @map("preferred_spec_id")
  groupNo                                  Int?                   @map("group_no") @db.UnsignedTinyInt
  orderIndex                               Int                    @default(0) @map("order_index") @db.SmallInt
  status                                   Int                    @default(0) @db.TinyInt
  note                                     String?                @db.VarChar(255)
  officerNote                              String?                @map("officer_note") @db.VarChar(255)
  handledBy                                BigInt?                @map("handled_by") @db.UnsignedBigInt
  handledAt                                DateTime?              @map("handled_at") @db.DateTime(0)
  decisionReason                           String?                @map("decision_reason") @db.VarChar(255)
  signedUpAt                               DateTime               @default(now()) @map("signed_up_at") @db.DateTime(0)
  confirmedAt                              DateTime?              @map("confirmed_at") @db.DateTime(0)
  cancelledAt                              DateTime?              @map("cancelled_at") @db.DateTime(0)
  created_at                               DateTime               @default(now()) @db.DateTime(0)
  updated_at                               DateTime               @default(now()) @db.DateTime(0)
  choices                                  ActivitySignupChoice[]
  activity                                 Activity               @relation(fields: [activityId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_signup_activity")
  character                                Character              @relation(fields: [characterId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_signup_character")
  users_activity_signups_handled_byTousers User?                  @relation("activity_signups_handled_byTousers", fields: [handledBy], references: [id], onUpdate: Restrict, map: "fk_signup_handled_by")
  specs                                    specs?                 @relation(fields: [preferredSpecId], references: [id], onUpdate: Restrict, map: "fk_signup_preferred_spec")
  user                                     User                   @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_signup_user")
  attendanceRecords                        AttendanceRecord[]

  @@unique([activityId, userId], map: "uk_activity_user")
  @@index([characterId], map: "fk_signup_character")
  @@index([userId], map: "fk_signup_user")
  @@index([handledBy], map: "idx_signup_handled_by")
  @@index([preferredSpecId], map: "idx_signup_preferred_spec")
  @@map("activity_signups")
}

model ActivitySignupChoice {
  id          BigInt         @id @default(autoincrement()) @db.UnsignedBigInt
  signupId    BigInt         @map("signup_id") @db.UnsignedBigInt
  characterId BigInt         @map("character_id") @db.UnsignedBigInt
  specId      Int            @map("spec_id")
  priority    Int            @db.UnsignedTinyInt
  createdAt   DateTime       @default(now()) @map("created_at") @db.DateTime(0)
  character   Character      @relation(fields: [characterId], references: [id], onUpdate: Restrict, map: "fk_signup_choice_character")
  signup      ActivitySignup @relation(fields: [signupId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_signup_choice_signup")
  specs       specs          @relation(fields: [specId], references: [id], onUpdate: Restrict, map: "fk_signup_choice_spec")

  @@unique([signupId, priority], map: "uk_signup_choice_priority")
  @@unique([signupId, characterId, specId], map: "uk_signup_character_spec")
  @@index([characterId], map: "idx_signup_choice_character")
  @@index([specId], map: "idx_signup_choice_spec")
  @@map("activity_signup_choices")
}

model AttendanceRecord {
  id                                          BigInt          @id @default(autoincrement()) @db.UnsignedBigInt
  activityId                                  BigInt          @map("activity_id") @db.UnsignedBigInt
  signupId                                    BigInt?         @map("signup_id") @db.UnsignedBigInt
  userId                                      BigInt          @map("user_id") @db.UnsignedBigInt
  characterId                                 BigInt?         @map("character_id") @db.UnsignedBigInt
  specId                                      Int?            @map("spec_id")
  wclReportId                                 BigInt?         @map("wcl_report_id") @db.UnsignedBigInt
  characterNameSnapshot                       String?         @map("character_name_snapshot") @db.VarChar(64)
  realmSnapshot                               String?         @map("realm_snapshot") @db.VarChar(64)
  specNameSnapshot                            String?         @map("spec_name_snapshot") @db.VarChar(25)
  roleSnapshot                                Int?            @map("role_snapshot") @db.TinyInt
  status                                      Int             @default(0) @db.TinyInt
  source                                      Int             @default(0) @db.TinyInt
  note                                        String?         @db.VarChar(255)
  recordedBy                                  BigInt          @map("recorded_by") @db.UnsignedBigInt
  recordedAt                                  DateTime        @default(now()) @map("recorded_at") @db.DateTime(0)
  createdAt                                   DateTime        @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt                                   DateTime        @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)
  manuallyConfirmed                           Boolean         @default(false) @map("manually_confirmed")
  activity                                    Activity        @relation(fields: [activityId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_attendance_activity")
  character                                   Character?      @relation(fields: [characterId], references: [id], onUpdate: Restrict, map: "fk_attendance_character")
  users_attendance_records_recorded_byTousers User            @relation("attendance_records_recorded_byTousers", fields: [recordedBy], references: [id], onUpdate: Restrict, map: "fk_attendance_recorded_by")
  signup                                      ActivitySignup? @relation(fields: [signupId], references: [id], onUpdate: Restrict, map: "fk_attendance_signup")
  specs                                       specs?          @relation(fields: [specId], references: [id], onUpdate: Restrict, map: "fk_attendance_spec")
  user                                        User            @relation(fields: [userId], references: [id], onUpdate: Restrict, map: "fk_attendance_user")
  wclReport                                   WclReport?      @relation(fields: [wclReportId], references: [id], onUpdate: Restrict, map: "fk_attendance_wcl_report")

  @@unique([activityId, userId], map: "uk_attendance_activity_user")
  @@index([userId, recordedAt], map: "idx_attendance_user_time")
  @@index([characterId], map: "idx_attendance_character")
  @@index([recordedBy], map: "idx_attendance_recorded_by")
  @@index([signupId], map: "idx_attendance_signup")
  @@index([specId], map: "idx_attendance_spec")
  @@index([wclReportId], map: "idx_attendance_wcl_report")
  @@map("attendance_records")
}

model WclReport {
  id                BigInt                    @id @default(autoincrement()) @db.UnsignedBigInt
  activityId        BigInt                    @map("activity_id") @db.UnsignedBigInt
  reportCode        String                    @unique(map: "uk_wcl_report_code") @map("report_code") @db.VarChar(32)
  region            String                    @default("CN") @db.VarChar(8)
  serverId          Int                       @default(569) @map("server_id")
  status            Int                       @default(0) @db.TinyInt
  reportStartAt     DateTime?                 @map("report_start_at") @db.DateTime(0)
  reportEndAt       DateTime?                 @map("report_end_at") @db.DateTime(0)
  importedAt        DateTime?                 @map("imported_at") @db.DateTime(0)
  errorMessage      String?                   @map("error_message") @db.Text
  summaryJson       Json?                     @map("summary_json")
  createdBy         BigInt                    @map("created_by") @db.UnsignedBigInt
  createdAt         DateTime                  @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt         DateTime                  @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)
  attendanceRecords AttendanceRecord[]
  suggestions       WclAttendanceSuggestion[]
  actors            WclReportActor[]
  activity          Activity                  @relation(fields: [activityId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_wcl_report_activity")
  users             User                      @relation(fields: [createdBy], references: [id], onUpdate: Restrict, map: "fk_wcl_report_created_by")

  @@index([activityId, createdAt], map: "idx_wcl_report_activity")
  @@index([createdBy], map: "idx_wcl_report_created_by")
  @@map("wcl_reports")
}

model WclAttendanceSuggestion {
  id                                                 BigInt     @id @default(autoincrement()) @db.UnsignedBigInt
  reportId                                           BigInt     @map("report_id") @db.UnsignedBigInt
  userId                                             BigInt     @map("user_id") @db.UnsignedBigInt
  characterId                                        BigInt?    @map("character_id") @db.UnsignedBigInt
  status                                             Int        @default(1) @db.TinyInt
  appliedAt                                          DateTime?  @map("applied_at") @db.DateTime(0)
  appliedBy                                          BigInt?    @map("applied_by") @db.UnsignedBigInt
  createdAt                                          DateTime   @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt                                          DateTime   @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)
  users_wcl_attendance_suggestions_applied_byTousers User?      @relation("wcl_attendance_suggestions_applied_byTousers", fields: [appliedBy], references: [id], onUpdate: NoAction, map: "fk_wcl_suggestion_applied_by")
  character                                          Character? @relation(fields: [characterId], references: [id], onUpdate: NoAction, map: "fk_wcl_suggestion_character")
  report                                             WclReport  @relation(fields: [reportId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_wcl_suggestion_report")
  user                                               User       @relation(fields: [userId], references: [id], onUpdate: NoAction, map: "fk_wcl_suggestion_user")

  @@unique([reportId, userId], map: "uk_wcl_suggestion_report_user")
  @@index([userId, appliedAt], map: "idx_wcl_suggestion_user")
  @@index([appliedBy], map: "fk_wcl_suggestion_applied_by")
  @@index([characterId], map: "fk_wcl_suggestion_character")
  @@map("wcl_attendance_suggestions")
}

model WclReportActor {
  id          BigInt     @id @default(autoincrement()) @db.UnsignedBigInt
