model Announcement {
  id           BigInt              @id @default(autoincrement()) @db.UnsignedBigInt
  title        String              @db.VarChar(128)
  content      String              @db.MediumText
  status       Int                 @default(0) @db.TinyInt
  audienceType Int                 @default(0) @map("audience_type") @db.TinyInt
  isPinned     Int                 @default(0) @map("is_pinned") @db.TinyInt
  publishAt    DateTime            @map("publish_at") @db.DateTime(0)
  expireAt     DateTime?           @map("expire_at") @db.DateTime(0)
  createdBy    BigInt              @map("created_by") @db.UnsignedBigInt
  updatedBy    BigInt              @map("updated_by") @db.UnsignedBigInt
  createdAt    DateTime            @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt    DateTime            @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)
  groups       AnnouncementGroup[]
  creator      User                @relation("AnnouncementCreatedBy", fields: [createdBy], references: [id], onUpdate: Restrict, map: "fk_announcement_created_by")
  updater      User                @relation("AnnouncementUpdatedBy", fields: [updatedBy], references: [id], onUpdate: Restrict, map: "fk_announcement_updated_by")

  @@index([status, publishAt, expireAt, isPinned], map: "idx_announcement_publish")
  @@index([createdBy], map: "idx_announcement_created_by")
  @@index([updatedBy], map: "idx_announcement_updated_by")
  @@map("announcements")
}

model AnnouncementGroup {
  announcementId BigInt       @map("announcement_id") @db.UnsignedBigInt
  groupId        BigInt       @map("group_id") @db.UnsignedBigInt
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_announcement_group_announcement")
  group          GuildGroup   @relation(fields: [groupId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_announcement_group_group")

  @@id([announcementId, groupId])
  @@index([groupId], map: "idx_announcement_group_group")
  @@map("announcement_groups")
}

