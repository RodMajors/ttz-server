  characterId BigInt?    @map("character_id") @db.UnsignedBigInt
  matchStatus Int        @default(0) @map("match_status") @db.TinyInt
  matchedBy   BigInt?    @map("matched_by") @db.UnsignedBigInt
  matchedAt   DateTime?  @map("matched_at") @db.DateTime(0)
  createdAt   DateTime   @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt   DateTime   @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)
  character   Character? @relation(fields: [characterId], references: [id], onUpdate: Restrict, map: "fk_wcl_actor_character")
  users       User?      @relation(fields: [matchedBy], references: [id], onUpdate: Restrict, map: "fk_wcl_actor_matched_by")
