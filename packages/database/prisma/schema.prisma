  @@unique([reportId, actorId], map: "uk_wcl_report_actor")
  @@index([characterId], map: "idx_wcl_actor_character")
  @@index([matchedBy], map: "idx_wcl_actor_matched_by")
  @@map("wcl_report_actors")
