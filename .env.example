NODE_ENV=development
PORT=3001
WEB_ORIGIN=http://localhost:3000
ASSET_BASE_URL=https://your-cos-domain.example.com
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=
# Optional when avatars use ASSET_BASE_URL; set this when avatars use another COS/CDN domain.
COS_PUBLIC_BASE_URL=
DATABASE_URL=mysql://user:password@127.0.0.1:3306/ttz
REDIS_URL=redis://127.0.0.1:6379
REDIS_ENABLED=false
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WCL_CLIENT_ID=
WCL_CLIENT_SECRET=
WCL_REGION=cn
WCL_REDIRECT_URI=http://127.0.0.1:3001/api/auth/wcl/callback
SESSION_COOKIE_NAME=ttz_session
SESSION_TTL_SECONDS=604800
QR_SESSION_TTL_SECONDS=300
# Only enables the fixed local development account; the API still requires a loopback request.
ALLOW_LOCAL_DEV_LOGIN=false
